include ../mixins/_mixins.pug
doctype html
html(lang="en" data-theme=theme)
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Express Hillel
    link(rel="icon" href="/favicon.ico")
    link(rel="stylesheet" href="/css/styles.css")
  body
    .container
      +authHeader(currentUser)
      .home-header
        h1 Express Hillel
        p Simple REST server with PUG & EJS templates
      nav.home-nav
        a.nav-card(href="/authors")
          .nav-card-icon 👤
          .nav-card-title Authors
          .nav-card-desc PUG templates
        a.nav-card(href="/articles")
          .nav-card-icon 📄
          .nav-card-title Articles
          .nav-card-desc EJS templates

      if testsRan
        .test-results
          .test-results-header
            .test-results-title
              span.test-results-icon ✅
              h2 Server Self-Test Results
            .test-summary(class=testsPassed === testsTotal ? 'test-summary--pass' : 'test-summary--fail')
              span #{testsPassed}/#{testsTotal} passed
            if testRunAt
              .test-run-at Run at #{new Date(testRunAt).toLocaleTimeString('en-GB', {hour: '2-digit', minute: '2-digit', second: '2-digit'})}
          ul.test-list
            each result in testResults
              li.test-item(class=result.passed ? 'test-item--pass' : 'test-item--fail')
                span.test-status= result.passed ? '✓' : '✗'
                span.test-name= result.name
                if !result.passed && result.error
                  span.test-error= result.error
      else
        .test-results.test-results--pending
          .test-results-header
            span.test-results-icon ⏳
            h2 Tests pending...

    +authModal()
    script(src="/js/cookie-consent.js")
    script(src="/js/auth-modal.js")
